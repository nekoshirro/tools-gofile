#!/bin/bash

# =========================================================
# CONFIGURATION
# =========================================================

if [ -f "$HOME/.secrets" ]; then
    source "$HOME/.secrets"
else
    echo "File .secrets not found in $HOME"
fi

if [ -f "$(pwd)/.secrets" ]; then
    source "$(pwd)/.secrets"
else
    echo "File .secrets not found in $(pwd)"
fi

# Colors for terminal output
BLD=$(tput bold)
RST=$(tput sgr0)
RED=$RST$(tput setaf 1)
GRN=$RST$(tput setaf 2)
BLD_GRN=$RST$BLD$(tput setaf 2)
CYN=$RST$(tput setaf 6)

# =========================================================
# TELEGRAM FUNCTIONS
# =========================================================

send_telegram() {
  local chat_id="$1"
  local message="$2"

  local _TK="$TG_BOT_TOKEN"

  echo -e "\n[$(date '+%Y-%m-%d %H:%M:%S')] Sending message to Telegram..."

  curl -s -X POST "https://api.telegram.org/bot${_TK}/sendMessage" \
    -d "chat_id=${chat_id}" \
    --data-urlencode "text=${message}" \
    -d "parse_mode=HTML" \
    -d "disable_web_page_preview=true" &> /dev/null
}

# =========================================================
# MAIN UPLOAD LOGIC
# =========================================================

if [ $# -eq 0 ]; then
    echo "${RED}Error: No file specified for upload."
    echo "Usage: $0 /path/to/your/file"
    exit 1
fi

# Fetch best gofile server
echo -e "${CYN}Fetching best server from Gofile...${RST}"
BEST_SERVER=$(curl -s https://api.gofile.io/servers | grep -oP '(?<="name":")[^"]*' | head -n 1)

if [ -z "$BEST_SERVER" ]; then
    echo "${RED}Failed to get active server. Falling back to store3...${RST}"
    BEST_SERVER="store3"
fi

for FILE in "$@"; do
  if [ ! -f "$FILE" ]; then
    echo "${RED} \"$FILE\" not found! Skipping."
    send_telegram "$TG_MAIN_CHAT_ID" "⚠️ <b>Warning:</b> File <code>${FILE}</code> not found."
    continue
  fi

  FILENAME="${FILE##*/}"
  FILESIZE=$(du -h "$FILE" | cut -f1)
  
  echo -e "${BLD_GRN}Uploading $FILENAME ($FILESIZE) via $BEST_SERVER... ${RST}"

  # Perform Upload
  RESPONSE=$(curl -# -F "file=@$FILE" "https://${BEST_SERVER}.gofile.io/contents/uploadfile")
  
  # Verify Upload Status
  UPLOAD_STATUS=$(echo "$RESPONSE" | grep -o '"status":"ok"')

  if [[ -n "$UPLOAD_STATUS" ]]; then
      # Extracting Link and MD5
      GOLINK=$(echo "$RESPONSE" | grep -oP '"downloadPage":"\K[^"]+')
      GOMD5=$(echo "$RESPONSE" | grep -oP '"md5":"\K[^"]+')
      
      echo -e "${BLD_GRN}✅ Success!${RST}"
      echo -e "${BLD}Link: ${CYN}${GOLINK}${RST}"

      # Assemble message using HTML tags for clean formatting
      # Using <b> for bold, <a> for links, and <code> for monospaced text
      success_message=$(printf "✅ <b>Upload Complete!</b>\n\n📄 <b>File:</b> <a href=\"%s\">%s</a>\n📦 <b>Size:</b> %s\n🔗 <b>Link:</b> %s\n🔑 <b>MD5:</b> <code>%s</code>" \
        "$GOLINK" "$FILENAME" "$FILESIZE" "$GOLINK" "$GOMD5")
      
      send_telegram "$TG_DOWNLOAD_CHAT_ID" "$success_message"
  else
      echo "${RED}❌ Upload failed! Response: $RESPONSE"
      send_telegram "$TG_MAIN_CHAT_ID" "❌ <b>Error:</b> Failed to upload <code>${FILENAME}</code>."
  fi
  echo ""
done

echo "Script finished."
